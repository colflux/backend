# Copiar a .env (gitignoreado) y completar con los valores reales.
# En el servidor de producción, este archivo vive solo ahí y nunca se pisa con git pull.

# Base de datos RDS (colflux-DB) — no hay Postgres local en Docker, todos los
# entornos (local y producción) se conectan a la misma instancia gestionada.
DATABASE_URL=postgres://usuario:contraseña-url-encoded@host-rds:5432/nombre_db

# Puerto publicado en el host — cambiar si ya está ocupado por otro
# proyecto en el mismo servidor.
WEB_PORT=8000

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

LOAD_SEED_DATA=

# Envío de correo (usado por el flujo de "olvidé mi contraseña"). En local,
# deja EMAIL_HOST_USER vacío y no se necesita nada más: el backend cae solo
# al backend de consola (imprime el correo en el log del contenedor en vez
# de enviarlo de verdad). En producción, usa una cuenta de Gmail con una
# "contraseña de aplicación" (no la contraseña normal de la cuenta) — ver
# https://myaccount.google.com/apppasswords. Para más volumen a futuro,
# migrar a un proveedor transaccional (ej. Brevo) sin cambiar el código.
EMAIL_HOST_USER=colflux.plataforma@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=COLFLUX <colflux.plataforma@gmail.com>
