# Copiar a .env (gitignoreado) y completar con los valores reales.
# En el servidor de producción, este archivo vive solo ahí y nunca se pisa con git pull.

# Base de datos RDS (colflux-DB) — no hay Postgres local en Docker, todos los
# entornos (local y producción) se conectan a la misma instancia gestionada.
DATABASE_URL=postgres://usuario:contraseña-url-encoded@host-rds:5432/nombre_db

# Puerto publicado en el host — cambiar si ya está ocupado por otro
# proyecto en el mismo servidor.
WEB_PORT=8000

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

LOAD_SEED_DATA=
